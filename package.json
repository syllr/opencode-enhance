{
  "name": "opencode-enhance",
  "version": "0.0.1",
  "description": "OpenCode plugin that ships your own agents, skills, commands and prompt rules as package content",
  "main": "src/index.js",
  "type": "module",
  "files": [
    "index.js",
    "src/index.js",
    "src/plugin.js",
    "src/frontmatter.js",
    "src/agent/loader.js",
    "src/command/loader.js",
    "src/rule/loader.js",
    "src/skill/loader.js",
    "agents",
    "commands",
    "rules",
    "skills",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:bump": "node scripts/release.mjs --bump",
    "release:check": "node scripts/release.mjs --check",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "skills",
    "commands",
    "rules"
  ],
  "author": "yutao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syllr/opencode-enhance.git"
  },
  "devDependencies": {
    "vitest": "^2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
